{
  "name": "taplist",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "app",
    "worker",
    "scraper"
  ],
  "scripts": {
    "dev:app": "npm run dev -w app",
    "dev:worker": "npm run dev -w worker",
    "build": "npm run build -w app",
    "deploy": "npm run build -w app && npm run deploy -w worker",
    "scrape": "node scraper/index.js",
    "scrape:dry": "node scraper/index.js --dry-run"
  }
}
